# VibeListen Environment Configuration

# 1. Raindrop.io Integration Settings
# Generate a static "Test Token" by going to: https://app.raindrop.io/settings/integrations
# Create a new App and click "Create test token" at the bottom.
RAINDROP_TOKEN=your_raindrop_personal_test_token_here

# 2. Network & Public/Local Tunnel Configuration
# If listening on your phone via over-the-air feeds, set this to your ngrok, Tailscale IP, or LAN address.
BASE_URL=http://localhost:8000

# 3. TTS Engine Selection
# Options: edge (default), piper, pocket
# TTS_ENGINE=edge
# For Piper (local ONNX TTS), set:
# TTS_ENGINE=piper
# DEFAULT_VOICE=en_US-lessac-medium

# 4. Speech & TTS Voice Selection
#
# Microsoft Edge TTS voices (used when TTS_ENGINE=edge):
# - en-US-AvaNeural (Female, American - recommended)
# - en-US-AndrewNeural (Male, American)
# - en-US-EmmaNeural (Female, American)
# - en-US-GuyNeural (Male, American - robust standard)
# - en-GB-SoniaNeural (Female, British)
# - en-GB-RyanNeural (Male, British)
#
# Piper TTS voices (used when TTS_ENGINE=piper, auto-downloaded on first use):
# - en_US-lessac-medium
# - en_US-amy-medium
# - en_US-ryan-medium
# - en_GB-alan-medium
# - en_GB-alba-medium
#
# Pocket TTS voices (used when TTS_ENGINE=pocket):
# - default (auto-selects first available voice from kyutai/tts-voices HF repo)
# - cloned (uses reference WAV uploaded via Settings UI)
#
# To use Pocket TTS, uncomment:
# TTS_ENGINE=pocket
# DEFAULT_VOICE=default
#
# Reference audio for Pocket TTS voice cloning (set automatically via UI upload at /api/tts/reference)
# REFERENCE_WAV_PATH=/data/models/reference.wav
DEFAULT_VOICE=en-US-AvaNeural
